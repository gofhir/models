# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# FHIR specifications (downloaded, not committed)
specs/r4/*.json
specs/r4b/*.json
specs/r5/*.json
!specs/*/.gitkeep

# Build artifacts
dist/
cmd/generator/generator
/generator

# Temporary files
tmp/
*.tmp
*.log

# Hugo docs build artifacts
docs/public/
docs/resources/
docs/.hugo_build.lock
docs/_vendor/

# Go workspace (local development).
# Deliberately not committed: building each module in isolation is what proves
# its own go.mod/go.sum are complete, and CI runs with GOWORK=off.
go.work
go.work.sum

# Debug artifacts the generator writes when go/format rejects its output.
*.unformatted
