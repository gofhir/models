package {{.PackageName}}

// Ptr returns a pointer to v.
//
// Optional FHIR elements are pointers so that "absent" stays distinguishable from
// "present and empty" — an omitted Patient.active is not the same statement as
// active:false. That is the right model, but Go cannot take the address of a
// literal, so every optional field otherwise needs a named variable first:
//
//	family := "Smith"
//	given := "John"
//	name := {{.PackageName}}.HumanName{Family: &family, Given: []string{given}}
//
// With Ptr the intermediate variables go away:
//
//	name := {{.PackageName}}.HumanName{
//		Family: {{.PackageName}}.Ptr("Smith"),
//		Given:  []string{"John"},
//	}
func Ptr[T any](v T) *T {
	return &v
}

// Val dereferences p, returning the zero value of T when p is nil.
//
// It replaces the nil check that otherwise surrounds every read of an optional
// element:
//
//	var family string
//	if p.Name[0].Family != nil {
//		family = *p.Name[0].Family
//	}
//
// becomes:
//
//	family := {{.PackageName}}.Val(p.Name[0].Family)
//
// The zero value is not a substitute for knowing whether an element was present.
// Where that distinction matters — and in FHIR it frequently does, since a missing
// value and a false one mean different things — test the pointer instead.
func Val[T any](p *T) T {
	if p == nil {
		var zero T
		return zero
	}
	return *p
}

// First returns a pointer to the first element of s, or nil when s is empty.
//
// Most repeating FHIR elements are read for their first entry, and indexing a
// slice a server left empty panics:
//
//	family := {{.PackageName}}.Val({{.PackageName}}.First(patient.Name)).Family
//
// The result is a pointer into s, so writing through it modifies the slice.
func First[T any](s []T) *T {
	if len(s) == 0 {
		return nil
	}
	return &s[0]
}
