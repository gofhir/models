// UnmarshalResourceXML deserializes FHIR XML bytes to the correct resource type.
// It reads the root element name to determine the resource type, creates the
// appropriate struct via the registry, and calls UnmarshalXML.
func UnmarshalResourceXML(data []byte) (Resource, error) {
	// Reject over-deep documents before decoding. The XML decode path recurses
	// mutually — UnmarshalXML -> xmlDecodeContainedResource ->
	// xmlDecodeInlineResource -> UnmarshalXML — at roughly 1.4 KB of stack per
	// level, so a large enough body exhausts the goroutine stack. That surfaces
	// as `fatal error: stack overflow`, which recover() cannot catch: the whole
	// process dies, taking every in-flight request with it.
	//
	// Unlike the JSON path this is linear in memory rather than quadratic, so the
	// concern is purely the stack. The same MaxResourceDepth applies, for one
	// limit across both formats.
	if limit := MaxResourceDepth; limit > 0 {
		depth, err := xmlResourceNestingDepth(data, limit)
		if err != nil {
			return nil, err
		}
		if depth > limit {
			return nil, fmt.Errorf("%w: at least %d levels, limit is %d",
				ErrMaxResourceDepth, depth, limit)
		}
	}

	d := xml.NewDecoder(bytes.NewReader(data))
	for {
		tok, err := d.Token()
		if err != nil {
			return nil, fmt.Errorf("failed to find root element: %w", err)
		}
		if start, ok := tok.(xml.StartElement); ok {
			resource, err := NewResource(start.Name.Local)
			if err != nil {
				return nil, fmt.Errorf("unknown resource type %q: %w", start.Name.Local, err)
			}
			type xmlUnmarshaler interface {
				UnmarshalXML(*xml.Decoder, xml.StartElement) error
			}
			u, ok := resource.(xmlUnmarshaler)
			if !ok {
				return nil, fmt.Errorf("resource %s does not implement UnmarshalXML", start.Name.Local)
			}
			if err := u.UnmarshalXML(d, start); err != nil {
				return nil, err
			}
			return resource, nil
		}
	}
}

// xmlDecodePrimitiveString decodes a FHIR string primitive element.
// Returns the value from the "value" attribute and an *Element if extensions/id are present.
func xmlDecodePrimitiveString(d *xml.Decoder, start xml.StartElement) (*string, *Element, error) {
	var value *string
	var elem *Element

	for _, attr := range start.Attr {
		switch attr.Name.Local {
		case "value":
			v := attr.Value
			value = &v
		case "id":
			if elem == nil {
				elem = &Element{}
			}
			id := attr.Value
			elem.Id = &id
		}
	}

	for {
		tok, err := d.Token()
		if err != nil {
			return nil, nil, err
		}
		switch t := tok.(type) {
		case xml.StartElement:
			if t.Name.Local == "extension" {
				if elem == nil {
					elem = &Element{}
				}
				var ext Extension
				if err := ext.UnmarshalXML(d, t); err != nil {
					return nil, nil, err
				}
				elem.Extension = append(elem.Extension, ext)
			} else {
				if err := d.Skip(); err != nil {
					return nil, nil, err
				}
			}
		case xml.EndElement:
			return value, elem, nil
		}
	}
}

