{{- /* The fluent builder, shared by resources and datatypes.
       Kept in one place because the two used to be the same 120 lines copied
       twice, and the choice-exclusivity work had to land in both. */ -}}
{{define "builder"}}
// =============================================================================
// {{.Name}} - Fluent Builder
// =============================================================================

{{- $r := . }}

// {{$r.Name}}Builder provides a fluent API for constructing {{$r.Name}} {{if $r.IsResource}}resources{{else}}values{{end}}.
type {{$r.Name}}Builder struct {
	{{$r.LowerName}} *{{$r.Name}}
}

// New{{$r.Name}}Builder creates a new {{$r.Name}}Builder.
func New{{$r.Name}}Builder() *{{$r.Name}}Builder {
	return &{{$r.Name}}Builder{
{{- if $r.IsResource}}
		// Nothing to set: the type marker carries the resource type, so the zero
		// value is already correct both in memory and on the wire.
{{- end}}
		{{$r.LowerName}}: &{{$r.Name}}{},
	}
}

{{if $r.IsResource -}}
// Build returns the constructed {{$r.Name}} resource.
func (b *{{$r.Name}}Builder) Build() *{{$r.Name}} {
	return b.{{$r.LowerName}}
}
{{- else -}}
// Build returns the constructed {{$r.Name}}.
//
// A value, not a pointer: every consumer of a datatype takes one. Patient.Name is
// []HumanName so AddName wants a HumanName, and a pointer field like Range.Low is
// set through SetLow(Quantity), which takes the address itself. Returning *T meant
// writing AddName(*NewHumanNameBuilder()...Build()) — a dereference at every call
// site, to undo a pointer nobody asked for.
func (b *{{$r.Name}}Builder) Build() {{$r.Name}} {
	return *b.{{$r.LowerName}}
}
{{- end}}

{{range $r.Properties}}
{{- if not (eq .GoType "*interface{}")}}
{{- if .IsArray}}
{{ if hasPrefix .ElementType "*" -}}
// Add{{.Name}} adds a {{.Name}} element.
//
// Takes a plain value: the field is a slice of pointers so that an absent slot
// can be expressed, but a builder call is always adding a value. For a slot that
// is deliberately absent, build the slice directly and leave that entry nil.
func (b *{{$r.Name}}Builder) Add{{.Name}}(v {{derefType .ElementType}}) *{{$r.Name}}Builder {
	b.{{$r.LowerName}}.{{.Name}} = append(b.{{$r.LowerName}}.{{.Name}}, &v)
	return b
}
{{- else if and (eq .Name "Contained") (eq .ElementType "Resource") -}}
// Add{{.Name}} adds a resource to {{.Name}}.
//
// A nil resource is ignored rather than appended. Contained holds an interface, so
// a nil entry marshals as JSON null — which FHIR does not allow there, and which
// this library then drops on the way back in, so a document written with one
// re-reads shorter than it was written.
//
// Filtering at serialization time would fix that everywhere, but giving
// ContainedList a MarshalJSON costs 2.9x on every marshal that has no nil in it
// (419 -> 1209 ns/op, 1 -> 3 allocs), because encoding/json re-compacts whatever a
// MarshalJSON returns. That is the cost task 6.2 removed by deleting 437 of them.
// Guarding the builder is free and covers the path the documentation recommends;
// a struct literal can still put a nil there.
func (b *{{$r.Name}}Builder) Add{{.Name}}(v {{.ElementType}}) *{{$r.Name}}Builder {
	if v == nil {
		return b
	}
	b.{{$r.LowerName}}.{{.Name}} = append(b.{{$r.LowerName}}.{{.Name}}, v)
	return b
}
{{- else -}}
// Add{{.Name}} adds a {{.Name}} element.
func (b *{{$r.Name}}Builder) Add{{.Name}}(v {{.ElementType}}) *{{$r.Name}}Builder {
	b.{{$r.LowerName}}.{{.Name}} = append(b.{{$r.LowerName}}.{{.Name}}, v)
	return b
}
{{- end }}

{{- else if and .IsPointer .ChoiceSiblings}}
// Set{{.Name}} sets {{.ChoiceBase}}[x] to its {{.Name}} variant.
//
// A choice element holds exactly one variant, so the others are cleared. Without
// that, a chain of setters produced a document with several of them present at
// once, which no FHIR server will accept and which nothing here reported.
func (b *{{$r.Name}}Builder) Set{{.Name}}(v {{.BaseType}}) *{{$r.Name}}Builder {
	b.clear{{.ChoiceBase}}()
	b.{{$r.LowerName}}.{{.Name}} = &v
	return b
}

{{- else if .IsPointer}}
// Set{{.Name}} sets the {{.Name}} field.
func (b *{{$r.Name}}Builder) Set{{.Name}}(v {{.BaseType}}) *{{$r.Name}}Builder {
	b.{{$r.LowerName}}.{{.Name}} = &v
	return b
}

{{- else if .ChoiceSiblings}}
// Set{{.Name}} sets {{.ChoiceBase}}[x] to its {{.Name}} variant.
//
// A choice element holds exactly one variant, so the others are cleared.
func (b *{{$r.Name}}Builder) Set{{.Name}}(v {{.GoType}}) *{{$r.Name}}Builder {
	b.clear{{.ChoiceBase}}()
	b.{{$r.LowerName}}.{{.Name}} = v
	return b
}

{{- else}}
// Set{{.Name}} sets the {{.Name}} field.
func (b *{{$r.Name}}Builder) Set{{.Name}}(v {{.GoType}}) *{{$r.Name}}Builder {
	b.{{$r.LowerName}}.{{.Name}} = v
	return b
}

{{- end}}
{{- end}}
{{- end}}
{{- /* The _field companions. They are emitted by the struct template from
       HasExtension rather than existing as properties, so the builder could not
       see them and a caller had to leave the chain to attach an extension to a
       primitive — the one thing FHIR uses them for. */ -}}
{{range $r.Properties}}
{{- if .HasExtension}}
{{- if .IsArray}}

// Add{{.Name}}Ext attaches extensions to the {{.Name}} element added most
// recently.
//
// The two slices are parallel by position, so any earlier element that has no
// extension is filled in as nil first. Appending blindly instead would put the
// extension at the wrong index: after Add{{.Name}} twice, a bare append lands at
// position 0 and silently belongs to the first element rather than the second.
//
// A nil value is meaningful and can be passed deliberately: it is a position that
// has no extension.
func (b *{{$r.Name}}Builder) Add{{.Name}}Ext(v *Element) *{{$r.Name}}Builder {
	for len(b.{{$r.LowerName}}.{{.Name}}Ext) < len(b.{{$r.LowerName}}.{{.Name}})-1 {
		b.{{$r.LowerName}}.{{.Name}}Ext = append(b.{{$r.LowerName}}.{{.Name}}Ext, nil)
	}
	b.{{$r.LowerName}}.{{.Name}}Ext = append(b.{{$r.LowerName}}.{{.Name}}Ext, v)
	return b
}
{{- else}}

// Set{{.Name}}Ext sets the extensions carried by {{.Name}}, serialized as
// "_{{.JSONName}}".
//
// This is how a primitive expresses an extension: a data-absent-reason on a
// birthDate lives here, not on the value.
func (b *{{$r.Name}}Builder) Set{{.Name}}Ext(v Element) *{{$r.Name}}Builder {
	b.{{$r.LowerName}}.{{.Name}}Ext = &v
	return b
}
{{- end}}
{{- end}}
{{- end}}

{{- /* One clear per choice group, emitted from the group's first variant. */ -}}
{{- range $r.Properties}}
{{- if .ChoiceLead}}

// clear{{.ChoiceBase}} unsets every variant of {{.ChoiceBase}}[x], including the
// _field companions of the primitive ones.
func (b *{{$r.Name}}Builder) clear{{.ChoiceBase}}() {
	b.{{$r.LowerName}}.{{.Name}} = nil
{{- range .ChoiceSiblings}}
	b.{{$r.LowerName}}.{{.}} = nil
{{- end}}
}
{{- end}}
{{- end}}
{{end}}
